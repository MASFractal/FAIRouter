<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AI" Version="4.0.0" />
    <PackageReference Include="AI.LLM" Version="4.0.0" />
    <PackageReference Include="AI.NLP" Version="4.0.0" />
    <PackageReference Include="AI.NeuralNetworks" Version="4.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!-- Забор снимка замеров живет вне репозитория (каталог в .gitignore) и в сборку не входит: иначе
       локальная сборка вшивала бы в библиотеку разбор конкретных площадок рейтингов -->
  <ItemGroup>
    <Compile Remove="Catalog/Sources/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FAI.Router.Tests" />
  </ItemGroup>

  <!-- Профили задач по сериям рейтингов: один файл на обе версии библиотеки, см. BenchmarkPrior -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\Python\fai_router\data\benchmark_profiles.json" LogicalName="FAI.Router.benchmark_profiles.json" />
    <EmbeddedResource Include="..\..\..\Python\fai_router\data\benchmark-snapshot.json" LogicalName="FAI.Router.benchmark-snapshot.json" />
    <EmbeddedResource Include="..\..\..\Python\fai_router\data\popular_models.json" LogicalName="FAI.Router.popular_models.json" />
  </ItemGroup>

</Project>
